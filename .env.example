# Mani Marketing — Environment Variables
# Copy this to .env and fill in every value marked REQUIRED.
# NEVER commit .env to git.

# ══════════════════════════════════════════════════════════════════════════════
# CORE URLS  (change these when deploying to VPS — keep localhost for local dev)
# ══════════════════════════════════════════════════════════════════════════════
FRONTEND_URL=http://localhost:4200
NEXT_PUBLIC_BACKEND_URL=http://localhost:4200
BACKEND_INTERNAL_URL=http://postiz:5000
POSTIZ_PORT=4200

# ══════════════════════════════════════════════════════════════════════════════
# AUTH  (REQUIRED)
# ══════════════════════════════════════════════════════════════════════════════
# Generate with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ══════════════════════════════════════════════════════════════════════════════
# POSTGRES — main app database  (REQUIRED)
# ══════════════════════════════════════════════════════════════════════════════
POSTGRES_USER=mani
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=manidb

# ══════════════════════════════════════════════════════════════════════════════
# n8n — automation engine  (REQUIRED)
# ══════════════════════════════════════════════════════════════════════════════
N8N_USER=varun
N8N_PASSWORD=CHANGE_ME_n8n_ui_password
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME_n8n_db_password
N8N_DB=n8ndb
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678
# Generate with:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# ══════════════════════════════════════════════════════════════════════════════
# LLM GATEWAY  (Phase 1 — fill before using AI features)
# ══════════════════════════════════════════════════════════════════════════════
#
# OPTION A — Direct OpenAI
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o
#
# OPTION B — Anthropic via LiteLLM sidecar (docker-compose.llm.yml)
#   LLM_BASE_URL=http://litellm:4000/v1
#   LLM_API_KEY=sk-mani-local        (the LITELLM_MASTER_KEY below)
#   LLM_MODEL=anthropic/claude-sonnet-4-6
#
# OPTION C — Local Ollama (same server)
#   LLM_BASE_URL=http://ollama:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.1:70b
#
# OPTION D — Remote Ollama / LM Studio (owner's laptop)
#   LLM_BASE_URL=http://YOUR_LAN_IP:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.1:70b
#
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://litellm:4000/v1
LLM_API_KEY=CHANGE_ME
LLM_MODEL=gpt-4o

# Gateway service port (the gateway is what Postiz + n8n point at)
GATEWAY_PORT=3001

# PropMarket API port (properties, templates, campaigns)
PROPMARKET_API_PORT=3002

# Optional: fall back to a second provider if primary fails
# LLM_FALLBACK_BASE_URL=http://ollama:11434/v1
# LLM_FALLBACK_API_KEY=ollama
# LLM_FALLBACK_MODEL=llama3.1:8b

# Embeddings (defaults to same as chat if not set)
# EMBED_BASE_URL=
# EMBED_MODEL=text-embedding-3-small

# ══════════════════════════════════════════════════════════════════════════════
# LITELLM SIDECAR  (docker-compose.llm.yml only)
# ══════════════════════════════════════════════════════════════════════════════
LITELLM_MASTER_KEY=sk-mani-local
LITELLM_PORT=4000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# ══════════════════════════════════════════════════════════════════════════════
# OLLAMA SIDECAR  (docker-compose.llm.yml only)
# ══════════════════════════════════════════════════════════════════════════════
OLLAMA_PORT=11434

# ══════════════════════════════════════════════════════════════════════════════
# FILE STORAGE
# ══════════════════════════════════════════════════════════════════════════════
# local = stored in Docker volume (fine for single-server VPS)
# cloudflare = Cloudflare R2 (needed for multi-server or CDN delivery)
STORAGE_PROVIDER=local

# Fill these only if STORAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKETNAME=
CLOUDFLARE_BUCKET_URL=
CLOUDFLARE_REGION=auto

# ══════════════════════════════════════════════════════════════════════════════
# EMAIL  (optional — for approval-queue notifications, lead responses)
# ══════════════════════════════════════════════════════════════════════════════
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Mani Marketing

# ══════════════════════════════════════════════════════════════════════════════
# SOCIAL MEDIA API KEYS
# ══════════════════════════════════════════════════════════════════════════════
# Fill in whichever platforms you want to connect in Postiz.

X_URL=
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SLACK_ID=
SLACK_SECRET=
SLACK_SIGNING_SECRET=

# ══════════════════════════════════════════════════════════════════════════════
# PropMarket CUSTOM SETTINGS  (Phases 2–4)
# ══════════════════════════════════════════════════════════════════════════════

# Outbound SMS provider (for lead notifications + guest win-back)
# SMS_PROVIDER=twilio | vonage | sinch
SMS_PROVIDER=
SMS_FROM_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Lead form public base URL (for the per-property lead capture page)
LEAD_FORM_BASE_URL=http://localhost:4200/inquire
